# ── vLLM alternative (no API key needed) ──
# On the Windows host:  vllm serve <hf-model-id> --port 8000   (omit --api-key)
# Then uncomment the line below AND "# VLLM_API_BASE: ${VLLM_API_BASE}" in
# docker-compose.yml, and switch config.yaml to its commented vLLM entries.
# VLLM_API_BASE=http://172.27.240.1:8000/v1
# No VLLM_API_KEY required - config.yaml sends api_key: dummy, which keyless
# vLLM ignores.


